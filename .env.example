# PostgreSQL connection string
# En production Vercel : utilisez une URL avec pooler (Neon, Supabase, Vercel Postgres…)
DATABASE_URL="postgresql://user:password@localhost:5432/nubi_bar_menu"

# JWT secret for admin authentication (use a long random string in production)
JWT_SECRET="change-this-to-a-secure-random-string"

# Admin account created during seed
ADMIN_EMAIL="admin@nubi.bar"
ADMIN_PASSWORD="admin123"

# Server port — local dev only (Vercel gère le port automatiquement)
PORT=3001

# Optional: API URL for frontend (leave empty — same origin on Vercel)
VITE_API_URL=""
