{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "installCommand": "npm install",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/tables",
      "destination": "/admin-tables.html"
    },
    {
      "source": "/admin-tables.html",
      "destination": "/admin-tables.html"
    },
    {
      "source": "/admin/orders",
      "destination": "/admin-orders.html"
    },
    {
      "source": "/admin-orders.html",
      "destination": "/admin-orders.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}
